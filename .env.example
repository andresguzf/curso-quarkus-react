# Prefijo de la API. En desarrollo el proxy de Vite redirige /api a API_PROXY_TARGET (ver vite.config.ts)
VITE_API_URL=/api

# Destino del proxy /api de Vite en desarrollo (no llega al navegador).
# Vacío o sin definir: http://localhost:8080. Para probar contra Render:
# API_PROXY_TARGET=https://curso-quarkus-api.onrender.com
